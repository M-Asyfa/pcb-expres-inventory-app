DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_pcbexpressjogja
DB_USERNAME=inventory
DB_PASSWORD=inventory_secret
DB_CHARSET=utf8mb4

APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security: leave empty for dev open access, set strong random token for prod
# Generate with: openssl rand -hex 32
API_TOKEN=
# If true, all endpoints require token (including GET). Default false = only POST/PUT/DELETE protected
API_PROTECT_ALL=false

# Optional overrides for docker-compose
MARIADB_ROOT_PASSWORD=root
MARIADB_USER=inventory
MARIADB_PASSWORD=inventory_secret
DB_EXTERNAL_PORT=3306
BACKEND_EXTERNAL_PORT=8000

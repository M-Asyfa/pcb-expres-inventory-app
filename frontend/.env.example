# API URL: use /api (via Vite proxy) to work on localhost AND other PCs on same LAN
# Previously http://localhost:8000/api caused ERR_CONNECTION_REFUSED on other PCs because localhost points to that PC
# With /api, browser calls http://<your-ip>:5173/api -> Vite proxies to backend (http://backend or http://localhost:8000)
# For production, set absolute URL like http://192.168.1.10:8000/api or https://api.example.com/api
VITE_API_URL=/api
# Optional Bearer token for protected API (must match backend API_TOKEN)
VITE_API_TOKEN=
# For docker internal proxy target (frontend container -> backend)
# In docker-compose frontend uses VITE_PROXY_TARGET=http://backend automatically via process.env, but you can override
# VITE_PROXY_TARGET=http://backend
# Alternative old direct backend URL (not recommended for LAN): http://localhost:8000/api
